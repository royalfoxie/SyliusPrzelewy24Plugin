{
    "name": "bitbag/przelewy24-plugin",
    "keywords": ["sylius", "sylius-plugin"],
    "type": "sylius-plugin",
    "description": "Przelewy24 payment plugin for Sylius applications.",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.0",
        "sylius/sylius": "^2.0"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "BitBag\\SyliusPrzelewy24Plugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\BitBag\\SyliusPrzelewy24Plugin\\": "tests/",
            "spec\\BitBag\\SyliusPrzelewy24Plugin\\": "spec/"
        },
        "classmap": ["tests/Application/Kernel.php"]
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/thanks": true,
            "composer/package-versions-deprecated": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
